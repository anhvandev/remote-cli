#!/bin/sh
# Package hook: `rcli uninstall` stops and removes the service, removes this Device on the Server and
# deletes the local data and secrets. `$1` is `remove` on Debian and `0` on RPM erase.
set -e

case "${1:-}" in
    remove|0)
        if [ -x /usr/local/bin/rcli ]; then
            /usr/local/bin/rcli uninstall || echo "rcli: uninstall failed; check /var/log/syslog" >&2
        fi
        ;;
esac
